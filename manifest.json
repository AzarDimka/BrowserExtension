{
    "manifest_version": 3, 
    "name": "Моё расширение",
    "version": "0.0.1",
    "description": "Расширение которое сохраняет текст и URL", 
    "action" : {
        "default_popup" : "html/popup.html"
    },
    "icons" : {
        "16" : "icons/logo16.png",
        "32" : "icons/logo32.png"
    },
    "content_scripts" : [
        {
            "matches" : [
                "<all_urls>"
            ],
            "js" : [
                "js/content.js"
            ]
        }
    ], 
    "permissions" : [
        "contextMenus",
        "activeTab",
        "storage", 
        "downloads"
    ],
    "background": {
        "service_worker": "js/background.js"
    }
}